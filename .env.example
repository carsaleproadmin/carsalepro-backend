# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# THE canonical public origin of the website. Absolute URLs in emails, Stripe
# return URLs and listing/VIN-history links are built from it, so the FIRST
# entry is what everything uses. A comma-separated list is accepted for
# backward compatibility; every entry is also CORS-allowed.
WEB_ORIGIN=http://localhost:3000
# Additional browser origins allowed by CORS, comma-separated. Purely additive.
# Production must list every host the site is actually served from, e.g.
#   CORS_ORIGINS=https://carsalepro.de,https://www.carsalepro.de
# Vercel preview deployments (https://*.vercel.app) are always allowed.
CORS_ORIGINS=
APP_ENV=development

# --- Database (Postgres 16 + PostGIS) ---
# Local default matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://carsalepro:carsalepro@localhost:5433/carsalepro?schema=public

# --- Redis (BullMQ queues, link-codes, settings cache) ---
REDIS_URL=redis://localhost:6380

# --- Cloudflare R2 (S3-compatible) ---
# Endpoint pattern: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carsalepro-reports
# RETIRED — leave blank. This was a GLOBAL switch: any value made
# createPresignedDownloadUrl return an unsigned URL for EVERY object in the
# reports bucket, paid inspection PDFs and all. A non-empty value now fails the
# boot in production. Public images live in their own bucket (below).
R2_PUBLIC_URL=

# --- Cloudflare R2: dedicated PUBLIC bucket for showroom listing photos ---
# Permanent, cacheable, shareable image URLs. A separate BUCKET, not a prefix:
# publicity in R2 is a bucket-level property, so there is no way to expose
# `listings/` without exposing the paid PDFs beside it.
# Point R2_PUBLIC_BASE_URL at a custom domain (https://img.carsalepro.de), not
# the r2.dev development URL, which is rate-limited and not for production.
# Leave all four blank and nothing changes: `listing_photo.bucket` stays NULL
# and photos keep being served through 15-minute signed URLs.
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# --- Cloudflare R2: dedicated PRIVATE bucket for KYC identity documents ---
# SECURITY.md H2. Create a second bucket with NO public access and an R2 API
# token scoped to it alone, then set all three. Leave them blank in dev/CI and
# KYC objects fall back to the shared reports bucket above (a startup warning
# says so). NODE_ENV=production REQUIRES all three — the boot fails otherwise.
# Existing objects are moved with: npx ts-node scripts/migrate-kyc-objects.ts
R2_KYC_ACCESS_KEY_ID=
R2_KYC_SECRET_ACCESS_KEY=
R2_KYC_BUCKET=

# --- Quota & presigning ---
# The FREE tier is UNLIMITED since 2026-08 (PRO sells no-ads + branding, not a
# report count). FREE_REPORTS_LIMIT is only the seed value for DeviceQuota rows
# and the number quoted in the 402 body; it gates nothing unless the flag below
# is flipped to true. Do not try to "disable" the cap with FREE_REPORTS_LIMIT=0 —
# Joi rejects it (min 1), because a 0 would block the very first report.
FREE_REPORTS_LIMIT=3
ENFORCE_FREE_REPORT_LIMIT=false
PRESIGNED_UPLOAD_TTL=900
PRESIGNED_DOWNLOAD_TTL=3600
SIGNED_URL_TTL_MINUTES=15

# --- VIN decoder (free NHTSA vPIC — the mobile /vin route) ---
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api

# --- Paid VIN history: RETIRED (DEN-245) ---
# The paid provenance check is gone: the site sends the visitor to a partner
# instead, and `src/vin-history/` is deleted. VIN_HISTORY_PROVIDER,
# VIN_HISTORY_API_KEY, VIN_HISTORY_ALLOW_SYNTHETIC_SALE and CARAPI_API_KEY are
# no longer read by anything. Joi allows unknown keys, so a deploy that still
# carries them boots normally - clear them from the Render dashboard when
# convenient, and cancel the provider accounts they belong to.
#
# The free NHTSA decode above is UNAFFECTED: it is a different thing, it costs
# nothing, and the mobile /vin route depends on it.

# --- Boot-time self-check (src/health/startup-check.service.ts) ---
# Verifies env hygiene (BOM, stray quotes/whitespace in secrets), that both R2
# buckets answer HeadBucket and are different from each other, and that CORS has
# a real https origin. In production a failure stops the boot, because every one
# of these fails SILENTLY at runtime otherwise.
# STARTUP_CHECK_STRICT=false is the emergency exit: findings are logged, the
# service comes up anyway.
STARTUP_CHECK_STRICT=true
# Acknowledges, on the record, that KYC identity documents share the reports
# bucket. Without it a production boot with R2_KYC_* unset fails.
ALLOW_SHARED_KYC_BUCKET=false

# --- KYC document-number check (DEN-250) ---
# The machine-readable zone of an identity document is read at upload time and
# only its NUMBER is kept, hashed. It is what recognises the same document
# photographed a second time, which the file hash cannot.
#
# A failed read is a non-event: the platform behaves exactly as it did before
# the check existed. Set to false to stop reading altogether.
KYC_MRZ_OCR_ENABLED=true
# Directory holding `eng.traineddata`. Unset, tesseract.js downloads it from a
# CDN on first use - which works, but makes the first upload after a deploy
# depend on a third party.
KYC_MRZ_TESSDATA_PATH=
# Mixed into the stored document-number digest. A document number is short and
# structured, so an unpeppered digest of one is worth guessing, and after the
# retention purge these rows are all that remains of the document.
# CHANGING THIS RETIRES EVERY HASH ALREADY STORED - they stop matching, which
# lets an applicant through rather than accusing one.
KYC_ID_HASH_PEPPER=

# --- Auth (shared with the website NextAuth) ---
# MUST equal the website NEXTAUTH_SECRET (HS256 signing key).
JWT_SECRET=dev-shared-secret-change-me
JWT_EXPIRES_IN=30d
# Dedicated shared key for the internal POST /api/v1/auth/oauth-upsert endpoint
# (called server-to-server by the website on OAuth/magic-link sign-in). When
# blank, the endpoint falls back to comparing the x-internal-key against
# JWT_SECRET. Set this to a distinct strong value to decouple the two.
INTERNAL_API_KEY=

# --- Stripe (Connect Express + escrow). Test keys for staging. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# TWO webhook secrets, and they are not interchangeable. Stripe issues one per
# endpoint, and connected-account events (account.updated) are only delivered
# to an endpoint registered against the Connect application - so the platform
# endpoint and the Connect endpoint each need their own route and their own
# secret. Point them at POST /webhooks/stripe and POST /webhooks/stripe/connect
# respectively. Putting the same value in both means one endpoint is refusing
# every event it sends, and the startup check says so.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/inspector/onboarding
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/inspector/onboarding
# Country a payout account lands in when the inspector names none, ISO 3166-1
# alpha-2. An inspector who DOES name one is believed — any country, any legal
# form (individual / company / non_profit / government_entity) — so this is a
# fallback and not a restriction. Keep it equal to the platform's own Stripe
# country: creating accounts elsewhere needs cross-border payouts enabled, and
# Stripe's refusal reaches the inspector as `connect_country_unsupported`.
# Verify a new country with `node scripts/stripe-connect-smoke.mjs` before an
# inspector does it for you. An account's country can never be changed
# afterwards, which is why a later request naming another one is refused.
STRIPE_CONNECT_DEFAULT_COUNTRY=DE

# --- Mapbox (server-side geocoding) ---
MAPBOX_TOKEN=

# --- Email (Resend). Blank key => dev outbox (logs + DB only). ---
# Address verification and password reset are delivered ONLY by email since the
# raw tokens were removed from the API responses (SECURITY.md, Resolved/SEC-1),
# so an empty key in a real environment means those flows are undeliverable.
# Always forced to the dev outbox when NODE_ENV=test.
# EMAIL_FROM must be on a domain VERIFIED in the Resend dashboard, and Resend
# matches the domain exactly. `notifications.carsalepro.de` is verified; the
# apex `carsalepro.de` is not, and a From address on it is refused with
# "403 The carsalepro.de domain is not verified".
RESEND_API_KEY=
EMAIL_FROM=CarSalePro <no-reply@notifications.carsalepro.de>
# Optional Reply-To header on outgoing mail (e.g. a monitored support inbox).
EMAIL_REPLY_TO=

# --- SMS (Twilio). Blank => dev outbox. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push (FCM). Blank => dev outbox. ---
FCM_SERVICE_ACCOUNT_JSON=

# --- Scheduler (E11). 'false' disables the in-process @Cron jobs (e.g. when a
#     dedicated worker runs them via `npm run start:worker`). Always disabled in tests. ---
SCHEDULER_ENABLED=true

# --- Observability ---
# Leave blank to disable Sentry entirely
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
