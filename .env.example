# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
# Local default matches docker-compose.yml
DATABASE_URL=postgresql://carsalepro:carsalepro@localhost:5432/carsalepro?schema=public

# --- Cloudflare R2 ---
# Create an R2 API token at: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
# Endpoint pattern: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carsalepro-reports
# Optional CDN/public URL prefix. Leave empty to always presign downloads.
R2_PUBLIC_URL=

# --- Quota & presigning ---
FREE_REPORTS_LIMIT=3
PRESIGNED_UPLOAD_TTL=900
PRESIGNED_DOWNLOAD_TTL=3600

# --- VIN decoder ---
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api

# --- Observability ---
# Leave blank to disable Sentry entirely
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
