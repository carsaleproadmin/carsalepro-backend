// CarSalePro Backend — Prisma schema.
//
// Mobile MVP core (VinCache, DeviceQuota, Report) is preserved unchanged in
// shape; Report gains OPTIONAL website fields only (old mobile clients keep
// working). Website (Phase 2+) models follow doc 07 §10.
//
// PostGIS geography columns use the managed `postgis` extension. GIST indexes
// on those columns are added via raw SQL in the migration (Prisma cannot model
// indexes on Unsupported() columns).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Mobile MVP core (existing — do not break)
// ============================================================

/// Cache of NHTSA vPIC VIN-decode responses. Keyed by 17-char VIN.
model VinCache {
  vin       String   @id @db.VarChar(17)
  payload   Json
  source    String   @default("nhtsa-vpic")
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
  @@map("vin_cache")
}

/// Per-device quota state. Anti-tamper guard for FREE-tier 3-reports lifetime cap.
model DeviceQuota {
  deviceId         String    @id @map("device_id")
  freeReportsUsed  Int       @default(0) @map("free_reports_used")
  freeReportsLimit Int       @default(3) @map("free_reports_limit")
  isPro            Boolean   @default(false) @map("is_pro")
  proActivatedAt   DateTime? @map("pro_activated_at")
  proPlatform      String?   @map("pro_platform")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("device_quota")
}

/// One row per inspection report PDF uploaded to R2. Soft-deletable.
/// Website fields are all optional so legacy mobile uploads stay valid.
model Report {
  id          String    @id @default(cuid())
  deviceId    String    @map("device_id")
  code        String
  vin         String?   @db.VarChar(17)
  make        String?
  model       String?
  inspectedAt DateTime? @map("inspected_at")
  s3Key       String    @map("s3_key")
  sizeBytes   Int?      @map("size_bytes")
  hash        String?
  tier        String // "free" | "pro"
  uploaded    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  /// Structured-payload contract version (1 = validated ReportDataV1). Null = legacy free-form reportData.
  reportSchemaVersion Int?      @map("report_schema_version")
  /// When the inspector marked the inspection finished in the mobile app.
  finishedAt          DateTime? @map("finished_at")

  // --- website extension (all optional) ---
  userId         String? @map("user_id")
  orderId        String? @unique @map("order_id")
  qualityScore   Int?    @map("quality_score") // 0–100
  year           Int?
  mileageKm      Int?    @map("mileage_km")
  color          String?
  bodyType       String? @map("body_type")
  driveType      String? @map("drive_type")
  reportData     Json?   @map("report_data")
  photosManifest Json?   @map("photos_manifest")

  user    User?         @relation(fields: [userId], references: [id])
  order   Order?        @relation(fields: [orderId], references: [id])
  listing Listing?
  photos  ReportPhoto[]

  @@index([deviceId, createdAt])
  @@index([vin])
  @@index([userId])
  @@index([code])
  @@map("report")
}

/// One row per server-compressed report photo stored in R2.
/// Uploaded via multipart `POST /reports/:id/photos/upload`; the backend
/// downsizes/re-encodes before storage. `(reportId, kind, position)` is the
/// logical slot — re-uploading the same slot replaces the photo.
model ReportPhoto {
  id          String   @id @default(cuid())
  reportId    String   @map("report_id")
  /// Mobile slot key: exterior-front, wheel-fl, interior-1, damage-<id>, odometer, vin, zeroproof, ...
  kind        String
  position    Int      @default(0)
  r2Key       String   @unique @map("r2_key")
  publicUrl   String?  @map("public_url")
  /// Compressed size stored in R2.
  sizeBytes   Int      @map("size_bytes")
  /// Original upload size (diagnostics).
  sourceBytes Int?     @map("source_bytes")
  width       Int
  height      Int
  format      String   @default("jpeg")
  /// SHA-256 of the ORIGINAL bytes — idempotent re-upload short-circuit.
  hash        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, kind, position])
  @@index([reportId])
  @@map("report_photo")
}

// ============================================================
// Auth / Users
// ============================================================

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  passwordHash      String?
  name              String?
  phone             String?
  locale            String    @default("de")
  countryCode       String    @default("DE")
  role              Role      @default(USER)
  kycVerified       Boolean   @default(false)
  bannedAt          DateTime?
  totpSecret        String?
  notificationPrefs Json?
  gdprConsentAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  inspector           InspectorProfile?
  deviceLinks         DeviceLink[]
  ordersAsCustomer    Order[]              @relation("CustomerOrders")
  listings            Listing[]
  reportPurchases     ReportPurchase[]
  notifications       Notification[]
  reports             Report[]
  payments            Payment[]
  vinHistoryPurchases VinHistoryPurchase[]
  kycApplications     KycApplication[]
  authAccounts        AuthAccount[]
  verificationTokens  VerificationToken[]

  @@index([role])
  @@map("user")
}

/// OAuth / external identity links for NextAuth (Google, etc.).
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  type              String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_account")
}

/// Email verification / magic-link / password-reset tokens (hashed).
model VerificationToken {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  identifier String
  tokenHash  String    @unique @map("token_hash")
  purpose    String // verify_email | magic_link | password_reset
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verification_token")
}

model InspectorProfile {
  userId          String                                 @id @map("user_id")
  companyName     String?                                @map("company_name")
  taxId           String?                                @map("tax_id")
  vatId           String?                                @map("vat_id")
  baseAddress     String                                 @map("base_address")
  location        Unsupported("geography(Point, 4326)")?
  searchRadiusKm  Int                                    @default(50) @map("search_radius_km")
  available       Boolean                                @default(true)
  stripeAccountId String?                                @unique @map("stripe_account_id")
  stripeOnboarded Boolean                                @default(false) @map("stripe_onboarded")
  fcmToken        String?                                @map("fcm_token")
  cancelCount     Int                                    @default(0) @map("cancel_count")
  createdAt       DateTime                               @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]      @relation("InspectorOrders")
  offers  OrderOffer[]
  payouts Payout[]

  @@map("inspector_profile")
}

/// userId ↔ deviceId link (mobile archive in the web cabinet).
model DeviceLink {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  deviceId  String   @unique @map("device_id")
  linkedVia String   @map("linked_via") // code | admin
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_link")
}

// ============================================================
// KYC
// ============================================================

enum KycStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

model KycApplication {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  status       KycStatus @default(DRAFT)
  rejectReason String?   @map("reject_reason")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  submittedAt  DateTime? @map("submitted_at")
  createdAt    DateTime  @default(now())

  documents KycDocument[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("kyc_application")
}

model KycDocument {
  id            String    @id @default(cuid())
  applicationId String    @map("application_id")
  kind          String // id_front | id_back | selfie | gewerbeschein | insurance
  s3Key         String    @map("s3_key")
  /// Which R2 bucket holds the object. NULL means the legacy shared reports
  /// bucket; a value means the dedicated private KYC bucket. Recorded per row so
  /// the migration window is unambiguous rather than "everything moved at once".
  bucket        String?
  uploadedAt    DateTime  @default(now())
  purgedAt      DateTime? @map("purged_at")

  application KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// One document per kind. Re-uploading an ID front REPLACES it; without this
  /// the table accumulated rows and every reader picked one non-deterministically
  /// — the reviewer could be looking at a superseded document.
  @@unique([applicationId, kind])
  @@index([applicationId])
  @@map("kyc_document")
}

// ============================================================
// Orders / Geo
// ============================================================

enum OrderStatus {
  CREATED
  PAID
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  SUBMITTED
  APPROVED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

model Order {
  id          String                                @id @default(cuid())
  number      String                                @unique // ORD-#### autogen
  customerId  String                                @map("customer_id")
  inspectorId String?                               @map("inspector_id")
  status      OrderStatus                           @default(CREATED)
  vin         String?                               @db.VarChar(17)
  make        String
  model       String
  listingUrl  String?                               @map("listing_url")
  address     String
  location    Unsupported("geography(Point, 4326)")
  scheduledAt DateTime                              @map("scheduled_at")
  countryCode String                                @default("DE") @map("country_code")

  // money (integer cents)
  baseFeeCents        Int     @map("base_fee_cents")
  /// Distance the fare was calculated on. ROAD kilometres when the routing
  /// provider answered, great-circle × orderDetourFactor otherwise — see
  /// `routingSource`. Was purely great-circle before the ride-hailing tariff.
  distanceKm          Decimal @map("distance_km")
  distanceFeeCents    Int     @map("distance_fee_cents")
  /// Driving minutes the time component was calculated on.
  durationMin         Int?    @map("duration_min")
  timeFeeCents        Int     @default(0) @map("time_fee_cents")
  /// surge × peak, frozen at quote time. 1 when neither applied.
  surgeMultiplier     Decimal @default(1) @map("surge_multiplier") @db.Decimal(4, 2)
  /// True when the minimum fare floor raised the total.
  minimumFareApplied  Boolean @default(false) @map("minimum_fare_applied")
  /// 'mapbox' | 'haversine' — how distanceKm/durationMin were obtained.
  routingSource       String? @map("routing_source")
  totalCents          Int     @map("total_cents")
  platformFeeCents    Int     @map("platform_fee_cents")
  inspectorShareCents Int     @map("inspector_share_cents")
  currency            String  @default("EUR")

  contractId    String?   @unique @map("contract_id")
  autoApproveAt DateTime? @map("auto_approve_at")
  submittedAt   DateTime? @map("submitted_at")
  /// Deadline for finding an inspector, set when the payment is AUTHORIZED.
  /// Past it with nobody assigned, the cron releases the hold and cancels.
  ///
  /// **Null is load-bearing and must never be backfilled.** An order created
  /// before manual capture shipped already had its money CHARGED, so a release
  /// attempt would target a hold that does not exist. Null means "pre-manual-
  /// capture order — leave it alone".
  searchExpiresAt DateTime? @map("search_expires_at")
  createdAt     DateTime  @default(now())

  customer  User              @relation("CustomerOrders", fields: [customerId], references: [id])
  inspector InspectorProfile? @relation("InspectorOrders", fields: [inspectorId], references: [userId])
  report    Report?
  payment   Payment?
  payout    Payout?
  refunds   Refund[]
  dispute   Dispute?
  offers    OrderOffer[]
  events    OrderEvent[]
  contract  OrderContract?    @relation(fields: [contractId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([inspectorId])
  @@index([status, searchExpiresAt])
  @@map("order")
}

model OrderOffer {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  inspectorId String   @map("inspector_id")
  status      String   @default("PENDING") // PENDING|ACCEPTED|DECLINED|EXPIRED
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector InspectorProfile @relation(fields: [inspectorId], references: [userId])

  @@index([orderId])
  @@index([inspectorId, status])
  @@map("order_offer")
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  actor      String // userId | system | admin:userId
  type       String // status_change | offer_sent | note | ...
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  payload    Json?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_event")
}

// ============================================================
// Payments (ledger, amounts in integer cents)
// ============================================================

/// The money ledger row for one charge.
///
/// `status` gained `authorized` when order payments moved to manual capture:
/// `pending → authorized → succeeded` (captured), or `pending|authorized →
/// cancelled` when the hold is released. Non-order purposes (ppv, gold,
/// vin_history) are still charged immediately and never see `authorized`.
///
/// **`authorized` is not an OrderStatus.** Money state is orthogonal to
/// workflow state: an order whose card is authorized but which has no inspector
/// yet is `Order.status = PAID` + `Payment.status = 'authorized'`. Adding a
/// status to the order enum instead would have meant rewriting every transition
/// guard for a fact the state machine does not care about.
model Payment {
  id                      String    @id @default(cuid())
  orderId                 String?   @unique @map("order_id")
  purpose                 String // order | ppv | gold | vin_history
  userId                  String    @map("user_id")
  amountCents             Int       @map("amount_cents")
  currency                String    @default("EUR")
  status                  String // pending|authorized|succeeded|failed|cancelled
  stripePaymentIntentId   String?   @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  /// Card authorized, funds held, nothing taken yet.
  authorizedAt            DateTime? @map("authorized_at")
  /// Funds actually taken. Backfilled from `createdAt` for pre-manual-capture
  /// payments so an old charge is never mistaken for an open hold.
  capturedAt              DateTime? @map("captured_at")
  /// Hold released without charging.
  canceledAt              DateTime? @map("canceled_at")
  createdAt               DateTime  @default(now())

  order              Order?              @relation(fields: [orderId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  reportPurchase     ReportPurchase?
  vinHistoryPurchase VinHistoryPurchase?
  refund             Refund?

  @@index([userId])
  @@index([status, createdAt])
  @@map("payment")
}

/// A refund issued against a captured payment.
///
/// `orderId` is nullable because not every refundable charge belongs to an
/// order: a paid VIN history whose provider fails AFTER capture is refunded
/// automatically and has no order to hang off. Order refunds (fired only from
/// the state machine) still record the order; non-order refunds record the
/// payment instead, so every row still points at exactly one thing.
/// A Refund row means MONEY WENT BACK, or is still trying to. It is never
/// written for a hold that was merely released — an uncaptured authorization
/// never left the customer's account, so recording a "refund" for it would
/// double-count every cancelled-before-assignment order in the finance ledger.
/// That case emits an `authorization_released` OrderEvent instead.
///
/// Retry state mirrors `Payout` deliberately: a refund that Stripe rejects must
/// become a parked, visible, retryable operator task rather than a 500 thrown
/// into a state transition. Before this existed, a failed refund aborted
/// `cancel`, leaving the order in its old status with the money still taken —
/// and the customer looking at a generic error.
model Refund {
  id             String    @id @default(cuid())
  orderId        String?   @map("order_id")
  paymentId      String?   @unique @map("payment_id")
  amountCents    Int       @map("amount_cents")
  reason         String // cancel_before_assign|cancel_after_assign|dispute|admin|vin_history_provider_failed
  /// Null until Stripe accepts the refund. Nullable because the row is written
  /// BEFORE the provider call, so a failure is recorded rather than lost.
  stripeRefundId String?   @unique @map("stripe_refund_id")
  /// pending | succeeded | failed
  status         String    @default("pending")
  /// Provider attempts. Retries stop at a cap so a permanently broken refund
  /// becomes an operator task instead of an endless loop.
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  /// When the retry cron may try again. Null = terminal, needs a human.
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now())

  order   Order?   @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  /// One refund per (order, reason) — makes `settleRefund` an upsert, so a
  /// retried cancellation tops up the existing row instead of minting a second
  /// one and refunding twice.
  @@unique([orderId, reason])
  @@index([orderId])
  @@index([status, nextRetryAt])
  @@map("refund")
}

model Payout {
  id               String    @id @default(cuid())
  orderId          String    @unique @map("order_id")
  inspectorId      String    @map("inspector_id")
  amountCents      Int       @map("amount_cents")
  stripeTransferId String?   @unique @map("stripe_transfer_id")
  status           String // pending|paid|failed
  /// Transfer attempts. Retries stop at a cap so a permanently broken payout
  /// becomes an operator task instead of an hourly loop.
  attempts         Int       @default(0)
  lastError        String?   @map("last_error")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  /// When the retry cron may try again. Null = terminal, needs a human.
  nextRetryAt      DateTime? @map("next_retry_at")
  createdAt        DateTime  @default(now())

  order     Order            @relation(fields: [orderId], references: [id])
  inspector InspectorProfile @relation(fields: [inspectorId], references: [userId])

  @@index([inspectorId])
  @@index([status, nextRetryAt])
  @@map("payout")
}

/// Idempotency AND concurrency control for Stripe deliveries.
///
/// The row used to be written only after successful handling, which makes a
/// replay a no-op but does nothing about two deliveries of the SAME event
/// arriving at once — both found no row and both ran the handler, so a payment
/// could be captured or a payout transferred twice. Handling now *claims* the
/// event first (insert `claimed`), runs, then marks it `processed`; an
/// exception deletes the claim so Stripe's own retry can pick it up again.
/// A claim older than `WEBHOOK_CLAIM_STALE_MS` may be stolen, so a process that
/// died mid-handler cannot wedge an event forever.
model StripeWebhookEvent {
  id          String    @id // stripe event id
  type        String
  /// claimed | processed
  status      String    @default("processed")
  attempts    Int       @default(0)
  claimedAt   DateTime? @map("claimed_at")
  processedAt DateTime  @default(now())

  @@index([status, claimedAt])
  @@map("stripe_webhook_event")
}

// ============================================================
// Listings / Reports Store
// ============================================================

enum ListingStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SOLD
  HIDDEN
  DELETED
}

/// A car for sale.
///
/// Two provenances, distinguished by `source`:
///   - "report"  — backed by an inspection. `reportId` is set and the vehicle
///                 columns below are denormalised FROM that report.
///   - "manual"  — a private seller with no inspection. `reportId` is NULL and
///                 the vehicle columns are seller-declared (`vehicleData`).
///
/// `reportId` is nullable AND unique: Postgres treats NULLs as distinct in a
/// unique index, so any number of manual listings coexist while the single-use
/// Report-ID claim (one listing per report, ever) keeps working unchanged.
///
/// Nothing derived from an inspection may be inferred for a manual listing —
/// `verified` is false and `qualityScore` is null for them, always.
model Listing {
  id                String        @id @default(cuid())
  sellerId          String        @map("seller_id")
  reportId          String?       @unique @map("report_id")
  /// "report" | "manual" — how this listing's vehicle data was obtained.
  source            String        @default("report")
  status            ListingStatus @default(DRAFT)
  package           String        @default("standard") // standard | gold
  priceCents        Int           @map("price_cents")
  city              String
  plz               String?
  description       String?
  contactPhone      String?       @map("contact_phone")
  contactEmail      String?       @map("contact_email")
  // Denormalized vehicle facts. Copied from the report for source="report",
  // seller-declared for source="manual". Search reads THESE columns, never the
  // report relation, so both provenances are filterable the same way.
  vin               String?       @db.VarChar(17)
  make              String?
  model             String?
  year              Int?
  mileageKm         Int?          @map("mileage_km")
  fuelType          String?       @map("fuel_type")
  transmission      String?
  powerKw           Int?          @map("power_kw")
  firstRegistration DateTime?     @map("first_registration")
  /// HU/TÜV validity as the seller writes it ("2027-06") — free text, not a date.
  huValidUntil      String?       @map("hu_valid_until")
  color             String?
  bodyType          String?       @map("body_type")
  driveType         String?       @map("drive_type")
  /// Structured seller-declared payload (ListingVehicleV1Dto). Manual only.
  vehicleData       Json?         @map("vehicle_data")
  viewsCount        Int           @default(0) @map("views_count")
  /// When the showroom subset of a REPORT-backed listing's photos was copied
  /// into the public bucket. Report photos live in the private reports bucket
  /// beside paid PDFs, so they cannot be served directly — they are mirrored
  /// under a deterministic key instead. Null = not mirrored yet, fall back to
  /// signed URLs.
  publicPhotosMirroredAt DateTime? @map("public_photos_mirrored_at")
  publishedAt       DateTime?     @map("published_at")
  expiresAt         DateTime?     @map("expires_at")
  createdAt         DateTime      @default(now())

  seller User           @relation(fields: [sellerId], references: [id])
  report Report?        @relation(fields: [reportId], references: [id])
  photos ListingPhoto[]

  @@index([status, package, publishedAt])
  @@index([sellerId])
  @@index([make, model, year])
  @@map("listing")
}

/// One server-compressed photo belonging to a listing.
///
/// Report-backed listings show the inspector's photos (`Report.photosManifest`);
/// this table is the seller's own gallery for manual listings. Same compression
/// pipeline as report photos (`PhotoProcessingService`), different key space:
/// `listings/<sellerId>/<listingId>/<uuid>.jpg`.
model ListingPhoto {
  id          String   @id @default(cuid())
  listingId   String   @map("listing_id")
  r2Key       String   @unique @map("r2_key")
  /// Which R2 bucket holds the object. NULL = the private reports bucket, served
  /// through a 15-minute signed URL; a value = the dedicated PUBLIC bucket,
  /// served as a permanent immutable URL. Recorded per row so the cutover is a
  /// gradual, resumable migration rather than a flag day — and so code stays
  /// dark until `R2_PUBLIC_*` is configured.
  bucket      String?
  /// Compressed size stored in R2.
  sizeBytes   Int      @map("size_bytes")
  /// Original upload size (diagnostics).
  sourceBytes Int?     @map("source_bytes")
  width       Int
  height      Int
  format      String   @default("jpeg")
  /// SHA-256 of the ORIGINAL bytes — duplicate-upload short-circuit.
  hash        String?
  order       Int      @default(0)
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, order])
  @@map("listing_photo")
}

/// A pay-per-view unlock of one report.
///
/// `revokedAt` exists because `@@unique([userId, reportId])` makes the purchase
/// permanent: deleting the row on refund would be the obvious move and is the
/// wrong one — it erases the audit trail of a charge that really happened. So a
/// refunded purchase is marked instead, and both `assertReportAccess` (which
/// must now deny it) and `createPpvCheckout` (which must now let the same buyer
/// pay again) read the mark. Without the second half, a refund would lock the
/// customer out of ever re-buying that report.
model ReportPurchase {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  reportId      String    @map("report_id")
  paymentId     String    @unique @map("payment_id")
  /// Set when the underlying payment was refunded — access is revoked and the
  /// report may be purchased again.
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([userId, reportId])
  @@map("report_purchase")
}

// ============================================================
// Legal / Notifications / Admin / Settings
// ============================================================

model LegalTemplate {
  id        String   @id @default(cuid())
  key       String // contract_de | contract_eu | contract_en
  version   Int
  locale    String
  title     String
  bodyMd    String   @map("body_md")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@map("legal_template")
}

model OrderContract {
  id              String    @id @default(cuid())
  templateKey     String    @map("template_key")
  templateVersion Int       @map("template_version")
  renderedHtml    String    @map("rendered_html")
  /// The placeholder-substituted markdown the HTML was rendered from, frozen at
  /// render time. The PDF renders from this same string, so the two documents
  /// cannot disagree, and a later re-render cannot pick up changed order data.
  bodyMd          String?   @map("body_md")
  /// R2 key of the archived HTML. The key was computed and the object uploaded,
  /// but the key itself was never persisted, so the archive was unreachable.
  htmlS3Key       String?   @map("html_s3_key")
  pdfS3Key        String?   @map("pdf_s3_key")
  pdfRenderedAt   DateTime? @map("pdf_rendered_at")
  /// Render attempts, so the backfill cron can give up instead of looping.
  pdfAttempts     Int       @default(0) @map("pdf_attempts")
  pdfLastError    String?   @map("pdf_last_error")
  createdAt       DateTime  @default(now())

  order Order?

  @@index([pdfS3Key, pdfAttempts])
  @@map("order_contract")
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String    @unique @map("order_id")
  openedBy   String    @map("opened_by")
  reason     String
  status     String    @default("OPEN") // OPEN|RESOLVED_CUSTOMER|RESOLVED_INSPECTOR
  resolution String?
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("dispute")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  channel   String // email|sms|push|inapp
  payload   Json
  status    String    @default("queued") // queued|sent|failed
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("admin_audit_log")
}

model PlatformSetting {
  key       String   @id // orderBaseFeeEur, platformFeePercent, ...
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt

  @@map("platform_setting")
}

// ============================================================
// VIN history (paid, third-party provenance data)
//
// Deliberately separate from `VinCache`, which caches the FREE NHTSA decode and
// whose `payload` is a frozen mobile contract. Nothing here touches that table.
// ============================================================

/// Cached, normalised VIN history for one (vin, provider) pair.
///
/// Providers charge per lookup, so the fetch is cached for `vinHistoryCacheDays`
/// and SHARED across buyers: two users unlocking the same VIN inside the window
/// pay twice but the provider is queried once.
model VinHistoryReport {
  id          String   @id @default(cuid())
  vin         String   @db.VarChar(17)
  /// Provider that produced this payload ('mock' until a real one is wired).
  provider    String
  /// Normalised VinHistoryPayloadV1 — the contract the API serves.
  payload     Json
  /// LEGACY. The shared archive written before each buyer got their own
  /// snapshot; new rows leave it null. Kept because purchases fulfilled under
  /// the old scheme still resolve their download through it.
  rawS3Key    String?  @map("raw_s3_key")
  recordCount Int      @default(0) @map("record_count")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  expiresAt   DateTime @map("expires_at")

  purchases VinHistoryPurchase[]

  @@unique([vin, provider])
  @@index([expiresAt])
  @@map("vin_history_report")
}

/// One user's paid unlock of one VIN.
///
/// `@@unique([userId, vin])` makes /unlock idempotent: a user cannot be charged
/// twice for the same VIN, however many times the button is pressed or the
/// webhook is replayed.
///
/// `payload` and `s3Key` are the PAID ARTEFACT: an immutable snapshot of what
/// this buyer was sold, written once at fulfilment. They are deliberately a copy
/// of `report.payload` / `report.rawS3Key` rather than a reference, because the
/// linked `VinHistoryReport` is a SHARED provider cache that the next buyer of
/// the same VIN overwrites once the cache window lapses. Reads fall back to the
/// report only for purchases fulfilled before this column existed.
model VinHistoryPurchase {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  vin           String    @db.VarChar(17)
  reportId      String?   @map("report_id")
  paymentId     String?   @unique @map("payment_id")
  /// pending | ready | failed | refunded
  status        String    @default("pending")
  provider      String?
  failureReason String?   @map("failure_reason")
  /// Immutable snapshot of the payload this buyer paid for.
  payload       Json?
  /// R2 key of this buyer's own archived copy, served only via a signed URL.
  s3Key         String?   @map("s3_key")
  /// R2 key of the rendered PDF. The key carries the locale, so re-rendering in
  /// another language adds a document instead of overwriting one.
  pdfS3Key      String?   @map("pdf_s3_key")
  pdfLocale     String?   @map("pdf_locale")
  pdfRenderedAt DateTime? @map("pdf_rendered_at")
  /// Render attempts, capped — a payload the renderer cannot handle must not
  /// retry on every download. A render failure never fails the sale: the JSON
  /// view stays available.
  pdfAttempts   Int       @default(0) @map("pdf_attempts")
  createdAt     DateTime  @default(now()) @map("created_at")
  readyAt       DateTime? @map("ready_at")

  /// Opaque, unguessable token for the public report link, or null when the
  /// buyer has not shared it. Minting is explicit and revoking sets it back to
  /// null, so the link is off by default and its whole lifetime is the owner's
  /// decision. Unique because it is the sole lookup key on a public route.
  shareToken          String?   @unique @map("share_token")
  shareTokenCreatedAt DateTime? @map("share_token_created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  report  VinHistoryReport? @relation(fields: [reportId], references: [id])
  payment Payment?          @relation(fields: [paymentId], references: [id])

  @@unique([userId, vin])
  @@index([userId, createdAt])
  @@map("vin_history_purchase")
}

model WaitlistEntry {
  id        String                                 @id @default(cuid())
  email     String
  city      String?
  location  Unsupported("geography(Point, 4326)")?
  createdAt DateTime                               @default(now())

  @@map("waitlist_entry")
}
