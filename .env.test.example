# Template for .env.test — copy to `.env.test` and fill the R2 credentials.
#
# WHY THIS FILE EXISTS: test/helpers/load-env.ts tries `.env.test` first and
# falls back to `.env`. Without a `.env.test`, the e2e suite silently runs
# against the development database using the real Stripe, Mapbox and Sentry
# credentials from `.env`. That is the failure mode this file prevents.
#
# Setup:
#   docker compose up -d postgres redis
#   docker exec carsalepro-postgres psql -U carsalepro -d postgres \
#     -c "CREATE DATABASE carsalepro_test"
#   docker exec carsalepro-postgres psql -U carsalepro -d carsalepro_test \
#     -c "CREATE EXTENSION IF NOT EXISTS postgis"
#   npx dotenv -e .env.test -- npx prisma migrate deploy      # or set DATABASE_URL inline
#   npx dotenv -e .env.test -- npm run prisma:seed
#   npm run test:e2e -- --forceExit

NODE_ENV=test
LOG_LEVEL=warn

# A DEDICATED database, not the dev one. cleanDb() in test/helpers/test-app.ts
# only truncates five tables and the suites leave users and orders behind, so a
# separate database is what makes reruns deterministic.
DATABASE_URL=postgresql://carsalepro:carsalepro@localhost:5433/carsalepro_test?schema=public
REDIS_URL=redis://localhost:6380/1

JWT_SECRET=test-secret-not-used-in-any-real-environment
WEB_ORIGIN=http://localhost:3000

# R2 must be real: report-photo, report-sync and legal-contract suites branch on
# R2Service.isConfigured() and skip their meaningful assertions when it is off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=carsalepro-reports
R2_PUBLIC_URL=

# Leave the dedicated PUBLIC image bucket unset. The suite asserts the DARK
# default: `listing_photo.bucket` stays NULL, showroom photos are 15-minute
# signed URLs, and behaviour is byte-for-byte what shipped before permanent URLs
# existed. The configured world is exercised by stubbing the four public-bucket
# methods on R2Service (test/listings.e2e-spec.ts), which needs no second bucket
# — and setting these for real here would fail those baseline assertions.
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# Leave the dedicated KYC bucket unset: the suite exercises the dev FALLBACK
# (KYC objects land in the shared bucket, KycDocument.bucket stays NULL), which
# is what CI and every developer machine run.
R2_KYC_ACCESS_KEY_ID=
R2_KYC_SECRET_ACCESS_KEY=
R2_KYC_BUCKET=

# Leave every one of these EMPTY. They are not oversights:
#   STRIPE_SECRET_KEY  NODE_ENV=test already forces mock mode; empty makes it explicit.
#   MAPBOX_TOKEN       keeps RoutingService on the deterministic haversine path, so
#                      pricing assertions never depend on a live Directions call.
#   RESEND_API_KEY     the email provider must stay on the DevOutbox — the suite
#                      creates ~50 users per run.
#   SENTRY_DSN         no test noise in the Sentry project.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MAPBOX_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=

SCHEDULER_ENABLED=false
# FREE is unlimited (see .env.example). One test in test/reports.e2e-spec.ts
# flips ENFORCE_FREE_REPORT_LIMIT to true for an isolated app instance to pin
# the frozen 402 body the shipped Flutter client still handles — leave the
# ambient value false so the rest of the suite sees the production behavior.
FREE_REPORTS_LIMIT=3
ENFORCE_FREE_REPORT_LIMIT=false
PRESIGNED_UPLOAD_TTL=900
PRESIGNED_DOWNLOAD_TTL=3600
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api
